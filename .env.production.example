# TEMPLATE ONLY: do not use the development Supabase project or commit real values.
# These settings are prerequisites, not evidence that all release gates passed.
LEXVIGIL_ENV=production
AUTH_PROVIDER=supabase
APP_ORIGIN=https://your-approved-domain.example
DATABASE_URL=postgresql+psycopg://app:REPLACE_ME@production-db.example/lexvigil?sslmode=verify-full
# Supply the provider's trusted CA through a secret/config mount if required.
PGSSLROOTCERT=/run/config/postgres-root.crt
SUPABASE_URL=https://YOUR_SEPARATE_PRODUCTION_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Generate securely; escrow/recovery must be approved and rehearsed before use.
ORIGINAL_ENCRYPTION_KEY=
# Do not increase until shared quota/rate controls and production queue are tested.
WEB_CONCURRENCY=1
OPENAI_API_KEY=
# Choose only models actually available to the production account and evaluate them.
OPENAI_RESEARCH_MODEL=
OPENAI_CONTRACT_MODELS=
